// AlphaDes data model.
//
// The shape follows one rule from the build plan:
//   FIRST sighting of a contract address creates a Call.
//   EVERY later sighting attaches to that Call as a CallEvent.
// That is what turns the channels' own "we hit 3x" milestone posts into free
// data sitting next to our measured numbers, instead of duplicate calls.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Neon POOLED connection — hostname contains "-pooler". Used at runtime.
  url       = env("DATABASE_URL")
  // Same credentials WITHOUT "-pooler". Migrations and `db push` only:
  // Neon's pooler cannot run them, and the failure is confusing.
  directUrl = env("DIRECT_URL")
}

/// How a channel phrases a call. The two we watch are shaped completely
/// differently, and the rule set is picked from this field — never from a
/// channel id. Adding a third channel means an insert plus, at worst, a new
/// value here.
///   BARE_CA   the call IS the address, posted alone. Commentary arrives as
///             separate messages seconds later. (e.g. "<private-channel>")
///   NARRATIVE the call is prose around an address ("Aped $JAS. Rn at 87k MC"),
///             interleaved with third-party scanner cards. (e.g. AlphaDesJurix)
enum ChannelKind {
  BARE_CA
  NARRATIVE
}

/// Whether a channel's calls count.
///   TRACK    ingested, stored, and part of the public track record.
///   OBSERVE  watched for ingestion measurements only (live vs poll, latency).
///            Nothing it posts is written to the database, so nothing it posts
///            can reach the track record — by construction, not by a filter
///            someone has to remember to apply in Phase 6.
enum ChannelRole {
  TRACK
  OBSERVE
}

/// Channels are CONFIGURATION, not code. Adding the second channel is an
/// insert, not a deploy. The worker reads this table on start and reloads it.
model Channel {
  id            String   @id @default(cuid())
  /// Telegram numeric id. Private channels have this and nothing else.
  telegramId    BigInt   @unique
  /// @handle, when the channel is public. Null for private channels.
  username      String?
  displayName   String
  /// Which rule set the classifier applies. Configuration, like the row itself.
  /// Unused for OBSERVE channels, whose messages are never classified into rows.
  kind          ChannelKind
  role          ChannelRole @default(TRACK)
  active        Boolean  @default(true)
  /// Set once the historical backfill has run for this channel.
  backfilledAt  DateTime?
  addedAt       DateTime @default(now())

  /// Catch-up high-water mark: the highest Telegram message id we have
  /// processed for this channel. On reconnect we fetch everything above it.
  /// Null means nothing processed yet, which is what triggers the backfill.
  lastSeenMessageId BigInt?
  /// When that message was posted. Old is NORMAL — a quiet channel is quiet.
  /// When we last polled Telegram is deliberately NOT stored: writing it on
  /// every poll kept Neon awake around the clock. It lives in process memory.
  lastSeenAt        DateTime?

  calls    Call[]
  events   CallEvent[]
  messages SeenMessage[]

  @@index([active])
}

/// What the address format tells us, and no more. A base58 32-byte key is
/// Solana; an 0x + 40 hex string is *some* EVM chain — the dumps contain
/// HyperEVM and BNB calls and the address alone cannot tell them apart.
/// Narrowing EVM to a specific chain needs a metadata lookup; that is Phase 2.
enum Chain {
  SOLANA
  EVM
}

model Token {
  id              String   @id @default(cuid())
  /// Solana base58 (32 decoded bytes) or EVM 0x-hex. See Chain.
  address         String   @unique
  chain           Chain
  symbol          String?
  name            String?
  imageUrl        String?
  /// Socials as reported by DexScreener metadata.
  websiteUrl      String?
  twitterUrl      String?
  telegramUrl     String?
  /// Primary pool used for OHLCV lookups.
  poolAddress     String?
  firstSeenAt     DateTime @default(now())
  metadataFetched Boolean  @default(false)

  calls     Call[]
  narrative Narrative?
  snapshots PriceSnapshot[]
}

enum CallStatus {
  ACTIVE
  CLOSED_DEAD      // liquidity pulled, volume zero, or price below floor
  CLOSED_MANUAL
}

/// Whether we watched the call land or reconstructed it from history.
/// A backfilled call is real, but we were not there for it: its called-at
/// market cap has to be rebuilt (Phase 2) and can never be as good as measured.
enum CallSource {
  LIVE
  BACKFILL
}

model Call {
  id        String   @id @default(cuid())
  tokenId   String
  channelId String
  token     Token    @relation(fields: [tokenId], references: [id])
  channel   Channel  @relation(fields: [channelId], references: [id])

  /// When the call landed in the channel (message timestamp, not ingest time).
  calledAt  DateTime
  /// LIVE if the listener saw it arrive; BACKFILL if it was read out of
  /// history when the channel was switched on.
  source    CallSource @default(LIVE)
  /// Telegram message id of the first sighting.
  messageId BigInt

  /// THE number that cannot be reconstructed later. Everything on the site is
  /// a multiple of this. Captured at ingestion; for backfilled calls, rebuilt
  /// from GeckoTerminal OHLCV and marked below.
  calledAtMarketCapUsd  Decimal? @db.Decimal(20, 4)
  marketCapIsBackfilled Boolean  @default(false)

  /// What the CALLER said the market cap was ("Rn at 87k MC" -> 87000). A
  /// claim, not a measurement. Kept strictly separate from the field above and
  /// never merged into it: the whole point of the public record is that our
  /// number is ours. Null for channels that do not state one, which is most of
  /// <private-channel>.
  statedMarketCapUsd    Decimal? @db.Decimal(20, 4)

  /// Measured by our own polling, not claimed by the channel.
  peakMarketCapUsd    Decimal?  @db.Decimal(20, 4)
  peakAt              DateTime?
  latestMarketCapUsd  Decimal?  @db.Decimal(20, 4)
  latestAt            DateTime?

  status      CallStatus @default(ACTIVE)
  closedAt    DateTime?
  closeReason String?

  events      CallEvent[]
  journal     JournalEntry[]

  /// One call per token per channel. A re-post is an event, not a new call.
  @@unique([tokenId, channelId])
  @@index([calledAt])
  @@index([status])
}

enum CallEventKind {
  FIRST_CALL
  CHANNEL_MILESTONE   // the channel's own "we hit 3x" post
  REPOST
  SCANNER_CARD        // a third party's bot card about a token we track
  COMMENTARY          // chatter posted moments after a BARE_CA call
  UNCLASSIFIED        // a milestone we could not attribute. callId is null.
}

model CallEvent {
  id        String        @id @default(cuid())
  /// NULL when we could not attribute the message to a call. We still keep the
  /// row: the raw text is evidence, and a parent we cannot identify today may
  /// be identifiable later. What we never do is guess one.
  callId    String?
  channelId String
  call      Call?         @relation(fields: [callId], references: [id], onDelete: Cascade)
  channel   Channel       @relation(fields: [channelId], references: [id])

  kind      CallEventKind
  messageId BigInt
  postedAt  DateTime
  /// Raw message text, kept verbatim. We never lose the source.
  rawText   String
  hasMedia  Boolean       @default(false)
  /// The message this one replied to, kept so a reply CHAIN can be walked
  /// later: a milestone often replies to another milestone, which replies to
  /// the call. Without this the chain can only be walked while the batch is
  /// still in memory.
  replyToMessageId BigInt?
  /// Multiple the channel CLAIMED, when parseable. Ours is measured separately.
  claimedMultiple Decimal? @db.Decimal(12, 2)

  @@unique([channelId, messageId])
  @@index([callId, postedAt])
}

/// Generated once from the token's own socials, then never regenerated.
/// The narrative is a record of what was claimed AT CALL TIME.
model Narrative {
  id          String   @id @default(cuid())
  tokenId     String   @unique
  token       Token    @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  summary     String
  /// Where the text came from, shown on the card as a label.
  sourceNote  String   @default("Summarised from the project's own socials")
  model       String?
  generatedAt DateTime @default(now())
}

model PriceSnapshot {
  id           String   @id @default(cuid())
  tokenId      String
  token        Token    @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  at           DateTime @default(now())
  marketCapUsd Decimal? @db.Decimal(20, 4)
  priceUsd     Decimal? @db.Decimal(30, 18)
  liquidityUsd Decimal? @db.Decimal(20, 4)
  volume24hUsd Decimal? @db.Decimal(20, 4)

  @@index([tokenId, at])
}

/// How a message reached the worker.
///   LIVE      Telegram pushed it (the NewMessage event handler)
///   POLL      the 60s poll found it — the live path did not deliver it first
///   CATCHUP   read on startup or reconnect, after time we were not listening
///   BACKFILL  read from history when the channel was first switched on
/// POLL is the number to watch: every POLL row is a message the live path
/// missed or delivered late.
enum IngestPath {
  LIVE
  POLL
  CATCHUP
  BACKFILL
}

/// Every message the listener has looked at, whatever we decided about it.
///
/// This exists for one reason: reply chains. A milestone usually replies to
/// another message rather than to the call — "3x" (1240) replies to a photo
/// (1237) which replies to the call (1234). If the intermediate message is not
/// stored, the chain dead-ends and the milestone attaches to nothing. Storing
/// only the messages we acted on breaks exactly the link we rely on most: 28 of
/// 31 milestones in the public channel resolve by reply.
///
/// It doubles as the precise record of what has been processed, which is what
/// makes replay after a crash cheap to reason about.
model SeenMessage {
  id               String   @id @default(cuid())
  channelId        String
  channel          Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  messageId        BigInt
  postedAt         DateTime
  replyToMessageId BigInt?
  /// Database time the row was written: "our write". writeLag is
  /// processedAt - postedAt, and includes any Neon cold start.
  processedAt      DateTime @default(now())
  /// Which path delivered the message first. Null for rows from before this
  /// was recorded.
  ingestPath       IngestPath?
  /// Worker clock when the message reached our code, before any database
  /// work. receivedLag is receivedAt - postedAt: how fast Telegram got it to
  /// us, with the database taken out of the number.
  receivedAt       DateTime?

  @@unique([channelId, messageId])
  @@index([channelId, postedAt])
}

model User {
  id        String   @id @default(cuid())
  privyId   String   @unique
  email     String?
  walletAddress String?
  createdAt DateTime @default(now())

  journal JournalEntry[]
}

enum PlayStatus {
  OPEN
  CLOSED
  RUGGED
}

/// Private to the user. Never shown publicly.
model JournalEntry {
  id      String @id @default(cuid())
  userId  String
  callId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  call    Call   @relation(fields: [callId], references: [id])

  /// Market cap the USER entered at. Compared against Call.calledAtMarketCapUsd
  /// to produce "you entered at 2.2x the call" — the most useful number here.
  entryMarketCapUsd Decimal? @db.Decimal(20, 4)
  exitMarketCapUsd  Decimal? @db.Decimal(20, 4)
  sizeSol           Decimal? @db.Decimal(20, 9)
  realisedPnlSol    Decimal? @db.Decimal(20, 9)

  status  PlayStatus @default(OPEN)
  note    String?
  openedAt DateTime  @default(now())
  closedAt DateTime?

  @@index([userId, openedAt])
  @@unique([userId, callId])
}
