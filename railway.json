{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run db:generate"
  },
  "deploy": {
    "startCommand": "npm run start -w @alphades/worker",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 600,
    "restartPolicyType": "ALWAYS",
    "overlapSeconds": "0",
    "drainingSeconds": "15",
    "multiRegionConfig": {
      "us-east4-eqdc4a": { "numReplicas": 1 }
    }
  }
}
