# ---------- Telegram (worker only) ----------
# Create YOUR OWN app at https://my.telegram.org/apps and use your own
# api_id / api_hash. Never use someone else's: the pair is tied to a
# person's Telegram account and is a permanent credential.
TG_API_ID=your_api_id_here
TG_API_HASH=

# Printed by `npm run tg:login`. Full access to the Telegram account.
# Never commit. Never paste into chat.
TG_SESSION=

# ---------- Database ----------
# Neon POOLED connection string — the hostname contains "-pooler".
# This is what the app uses at runtime.
DATABASE_URL=

# Same credentials, same database, but the DIRECT (non-pooled) hostname:
# identical to DATABASE_URL with "-pooler" removed. Prisma uses it for
# migrations and `db push` only. Neon's pooler cannot run migrations, and
# without this they fail confusingly.
DIRECT_URL=

# ---------- Channels (worker only) ----------
# Seeded into the Channel table by `npm run seed:channels`. Channels are
# configuration, not code: the worker reads the table, never these values.
# Numbering starts at 1 and stops at the first gap.
#   KIND      BARE_CA   the call is the bare contract address
#             NARRATIVE the call is prose wrapped around an address
#   USERNAME  the @handle without the @; leave empty for a private channel
#   ACTIVE    set to false to switch a channel off without deleting its calls
#   ROLE      TRACK (default) or OBSERVE. OBSERVE channels are measured for
#             ingestion latency and never written to the database, so nothing
#             they post can reach the track record.
# The worker reads channels at startup. After changing them, re-run
# `npm run seed:channels` and restart the worker.
CHANNEL_1_ID=
CHANNEL_1_KIND=BARE_CA
CHANNEL_1_NAME=
CHANNEL_1_USERNAME=

CHANNEL_2_ID=
CHANNEL_2_KIND=NARRATIVE
CHANNEL_2_NAME=
CHANNEL_2_USERNAME=

# ---------- Worker runtime ----------
# 60s on purpose: a faster poll would mask a dead live handler.
POLL_INTERVAL_MS=60000
# Railway only: wait this long before connecting to Telegram, so the previous
# deployment can release the session. Two processes on one session risks
# Telegram revoking it. Leave 0 locally.
STARTUP_DELAY_MS=0

# ---------- Auth (web only) ----------
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# ---------- Narrative generation (worker only) ----------
ANTHROPIC_API_KEY=

# ---------- Market data ----------
# DexScreener and GeckoTerminal need no key.
